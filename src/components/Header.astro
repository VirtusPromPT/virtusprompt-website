---
import { SITE, ROUTES, type Lang, type RouteKey } from '../config';
import { strings } from '../i18n/strings';

interface Props { lang: Lang; route: RouteKey }
const { lang, route } = Astro.props;
const t = strings[lang];
const home = ROUTES.home[lang];
---
<header class="top">
  <div class="wrap">
    <a class="brand" href={home}><i class="vp" aria-hidden="true"></i>{SITE.brand}</a>
    <nav class="nav" aria-label={t.nav.main}>
      <a href={`${home}#services`}>{t.nav.services}</a>
      <a href={`${home}#process`}>{t.nav.process}</a>
      <a href={`${home}#about`}>{t.nav.about}</a>
      <a href={`${home}#faq`}>{t.nav.faq}</a>
      <a href={`${home}#contact`}>{t.nav.contact}</a>
    </nav>
    <div class="lang" role="group" aria-label={t.langLabel}>
      <a href={ROUTES[route].pt} hreflang="pt-PT" lang="pt-PT" aria-current={lang === 'pt' ? 'true' : undefined} data-lang="pt">PT</a>
      <span aria-hidden="true">/</span>
      <a href={ROUTES[route].en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} data-lang="en">EN</a>
    </div>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t.theme.toDark} data-to-dark={t.theme.toDark} data-to-light={t.theme.toLight}>
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="btn btn--fill" href={SITE.calendly} target="_blank" rel="noopener">{t.cta.meeting}</a>
  </div>
</header>
