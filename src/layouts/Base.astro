---
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
// The fonts used above the fold on every page. Preloading them avoids a late font swap,
// which was shifting the hero (headline, intro text and drawing) on desktop.
import fontDisplayLight from '@fontsource/space-grotesk/files/space-grotesk-latin-300-normal.woff2?url';
import fontDisplayMedium from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import fontBody from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import fontMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
const preloadFonts = [fontDisplayLight, fontDisplayMedium, fontBody, fontMono];
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, ROUTES, type Lang, type RouteKey } from '../config';
import { strings } from '../i18n/strings';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** schema.org type of this page (WebPage, AboutPage, CollectionPage...). */
  pageType?: string;
  /** Extra schema.org nodes for this page, such as a Service or an Article. */
  schema?: Record<string, unknown>[];
}
const { lang, route, title, description, noindex = false, pageType = 'WebPage', schema = [] } = Astro.props;
const t = strings[lang];
const pageTitle = title ? `${title} | ${SITE.brand}` : t.meta.title;
const pageDesc = description ?? t.meta.description;
const canonical = new URL(ROUTES[route][lang], SITE.url).href;
const alt = (l: Lang) => new URL(ROUTES[route][l], SITE.url).href;
const ogImage = new URL(lang === 'en' ? '/og-en.png' : '/og-pt.png', SITE.url).href;
const inLanguage = lang === 'en' ? 'en' : 'pt-PT';

// Structured data (schema.org): one linked graph of the company, the website and this page.
const home = new URL('/', SITE.url).href;
const homeLang = new URL(ROUTES.home[lang], SITE.url).href;
const orgId = `${home}#organization`;
const personId = `${home}#person`;
const sameAs = SITE.profiles.map((p) => p.url);
const breadcrumb =
  route === 'home'
    ? []
    : [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: SITE.brand, item: homeLang },
            { '@type': 'ListItem', position: 2, name: title ?? pageTitle, item: canonical },
          ],
        },
      ];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.brand,
      legalName: SITE.legalName,
      alternateName: 'Virtuous Prompts',
      url: home,
      logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', SITE.url).href, width: 512, height: 512 },
      description: t.meta.description,
      email: SITE.email,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: SITE.email,
        availableLanguage: ['pt-PT', 'en'],
      },
      areaServed: { '@type': 'Country', name: 'Portugal' },
      employee: { '@id': personId },
      ...(SITE.nipc ? { taxID: SITE.nipc } : {}),
      ...(SITE.registeredOffice
        ? { address: { '@type': 'PostalAddress', streetAddress: SITE.registeredOffice, addressCountry: 'PT' } }
        : {}),
      ...(sameAs.length ? { sameAs } : {}),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.services.eyebrow,
        itemListElement: t.services.items.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.text, provider: { '@id': orgId } },
        })),
      },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.person,
      jobTitle: t.about.role,
      worksFor: { '@id': orgId },
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: SITE.brand,
      inLanguage: ['pt-PT', 'en'],
      publisher: { '@id': orgId },
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDesc,
      inLanguage,
      isPartOf: { '@id': `${home}#website` },
      about: { '@id': orgId },
      ...(breadcrumb.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    ...breadcrumb,
    ...schema,
  ],
};
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-PT'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="pt-PT" href={alt('pt')} />
        <link rel="alternate" hreflang="en" href={alt('en')} />
        <link rel="alternate" hreflang="x-default" href={alt('pt')} />
      </>
    )}
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#EEF0EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#011837" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pt_PT'} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Apply the visitor's saved theme before the page paints, to avoid a flash -->
    <script is:inline>
      try { var t = localStorage.getItem('vp-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar para o conteúdo'}</a>
    <Header lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/theme';
      import '../scripts/menu';
    </script>
  </body>
</html>
